<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.carl.mapper.ProductInventoryMapper">

    <resultMap id="BaseResultMap" type="com.carl.domain.ProductInventory">
            <id property="id" column="id" jdbcType="INTEGER"/>
            <result property="productId" column="product_id" jdbcType="INTEGER"/>
            <result property="qty" column="qty" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,product_id,qty
    </sql>
    <update id="decreaseProductInventory">
        update product_inventory
        set qty=qty-#{saleQty}
        where product_id=#{productId}
        and qty-#{saleQty}>=0
    </update>
</mapper>
